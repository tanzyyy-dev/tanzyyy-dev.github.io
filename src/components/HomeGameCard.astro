---
import type { Lang } from '../data/content';
import { gameUrl, type Game } from '../data/games';
interface Props { game: Game; lang: Lang; preview?: boolean; showFeature?: boolean }
const { game, lang, preview = false, showFeature = true } = Astro.props;
const Tag = preview ? 'div' : 'a';
const reason = game.homeFeature;
const badge = reason === 'new-release' ? 'NEW RELEASE' : reason === 'update' ? 'UPDATE' : 'RECOMMENDED';
const date = reason === 'new-release' ? game.releasedAt : reason === 'update' ? game.updatedAt : null;
const image = game.media.find(item => item.type === 'image');
const format = game.format === 'browser'
  ? (lang === 'ja' ? 'ブラウザゲーム' : 'Browser game')
  : (lang === 'ja' ? 'ダウンロードゲーム' : 'Download game');
---
<Tag class:list={['home-game-entry', { 'is-preview': preview }]} href={preview ? undefined : gameUrl(game, lang)} aria-label={preview ? undefined : `${game.title} — ${lang === 'ja' ? '作品詳細を見る' : 'View game details'}`}>
  <div class="home-game-image">
    {image ? <img src={image.src} alt={image.alt[lang]} loading="lazy" width="144" height="144"/> : <span aria-hidden="true">{game.title}</span>}
  </div>
  <div class="home-game-copy">
    {showFeature && <div class="home-game-status"><span class:list={['home-game-badge', reason]}>{badge}</span>{date && <time datetime={date}>{date.replaceAll('-', '.')}</time>}</div>}
    <h3>{game.title}</h3>
    <div class="home-game-meta"><span class="home-game-tag genre">{game.genre[lang]}</span><span class="home-game-tag format">{format}</span></div>
    <p class="home-game-summary">{game.summary[lang]}</p>
  </div>
</Tag>
<style>
.home-game-entry{display:grid;grid-template-columns:clamp(92px,10vw,132px) minmax(0,1fr);gap:16px;min-width:0;padding:14px;border:1px solid #D8B8A5;border-radius:10px;background:#F9F5F1;color:#292B2D;text-decoration:none;cursor:pointer;position:relative;z-index:0;transform:scale(1);transition:transform .24s ease,box-shadow .24s ease,background-color .24s ease;transform-origin:center}
.home-game-entry:not(.is-preview):hover{transform:scale(1.045);z-index:2;background:#FFF8F3;box-shadow:0 0 0 4px #B58A76,0 12px 24px rgba(80,53,39,.18)}
.home-game-entry:hover,.home-game-entry:focus-visible,.home-game-entry:hover *,.home-game-entry:focus-visible *{text-decoration:none}
.home-game-entry.is-preview{cursor:default;border-style:dashed;opacity:.8}
.home-game-entry.is-preview:hover{transform:none;box-shadow:none;background:#F9F5F1}
.home-game-entry:focus-visible{outline:3px solid #B58A76;outline-offset:5px;transform:scale(1.035);z-index:2}
@media(prefers-reduced-motion:reduce){.home-game-entry{transition:none}.home-game-entry:hover,.home-game-entry:focus-visible{transform:none}}
.home-game-image{display:block;aspect-ratio:1;overflow:hidden;border-radius:7px;background:#292B2D;color:#F0EFEB;text-decoration:none}
.home-game-image img{display:block;width:100%;height:100%;object-fit:cover}
.home-game-image span{display:flex;align-items:center;justify-content:center;height:100%;padding:8px;font-size:12px;text-align:center}
.home-game-copy{min-width:0}.home-game-status{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin-bottom:7px}
.home-game-badge{display:inline-block;border:1px solid #B7B9B6;border-radius:999px;padding:3px 9px;background:#B58A76;color:#fff;font-size:10px;font-weight:800;letter-spacing:.04em;line-height:1.4}
.home-game-badge.new-release{background:#F1E5DC;border-color:#B58A76;color:#784F3C}
.home-game-badge.update{background:#E7EFEF;border-color:#7C9C9B;color:#466B6A}
.home-game-badge.recommended{background:#B58A76;border-color:#B58A76;color:#fff}
.home-game-status time{color:#777A7B;font-size:11px;font-variant-numeric:tabular-nums}
h3{margin:0 0 5px;font-size:clamp(15px,1.5vw,19px);line-height:1.3;letter-spacing:-.025em;overflow-wrap:anywhere}

.home-game-meta{display:flex;flex-wrap:wrap;gap:5px;margin:0 0 8px}.home-game-tag{display:inline-block;padding:3px 9px;border:1.5px solid;border-radius:6px;font-size:11px;font-weight:700;line-height:1.5}.home-game-tag.genre{background:#EBD6C9;border-color:#D1A993;color:#76513F}.home-game-tag.format{background:#E1E9E7;border-color:#9EBBB4;color:#365E59}
.home-game-summary{margin:0;color:#55585A;font-size:12px;line-height:1.55}
@media(max-width:760px){.home-game-entry{grid-template-columns:96px minmax(0,1fr);gap:12px;padding:10px}}
@media(max-width:380px){.home-game-entry{grid-template-columns:80px minmax(0,1fr);gap:10px}}
</style>
