---
import ProjectList from './ProjectList.astro';
import { copy, type Lang } from '../data/content';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = copy[lang];
---
<div class="wrap page">
  <div class="page-heading">
    <h1>{t.projects}</h1>
    <p>{t.intro}</p>
  </div>
  <ProjectList lang={lang} />
</div>
