---
import type { Lang } from '../data/content';
import type { Tool, Content } from '../data/types';
import { availabilityStatusLabels } from '../data/games';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { lang: Lang; project: Tool | Content }
const { lang, project } = Astro.props;
const ja = lang === 'ja';
const prefix = ja ? '' : '/en';
const media = project.media[0];
const category = project.category === 'tools' ? 'Tools' : 'Contents';
---
<article class="wrap page other-detail">
  <Breadcrumbs lang={lang} items={[{ label: ja ? 'ホーム' : 'Home', href: prefix + '/' }, { label: ja ? '作品一覧' : 'Projects', href: prefix + '/projects/' }, { label: project.title }]} />
  <section class="other-sheet">
    <p class="other-category">{category}</p>
    <h1><span class={`availability-badge status-${project.availabilityStatus}`}>{availabilityStatusLabels[project.availabilityStatus][lang]}</span> {project.title}</h1>
    {media?.type === 'image' && <img class="other-cover" src={media.src} alt={media.alt[lang]} width="1200" height="630" />}
    {media?.type === 'video' && <video class="other-cover" controls preload="metadata" poster={media.poster} aria-label={media.alt[lang]}><source src={media.src}/></video>}
    {media?.placeholder && <p class="other-placeholder">{ja ? '※ 仮画像です' : 'Placeholder artwork'}</p>}
    <p class="other-summary">{project.summary[lang]}</p>
    <div class="other-actions">
      {project.availabilityStatus === 'active' && project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">{ja ? '作品を開く' : 'Open project'} ↗</a>}
      {project.repositoryUrl && <a href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">{ja ? 'ソースを見る' : 'View source'} ↗</a>}
    </div>
  </section>
</article>
<style>
.other-sheet{background:#fff;border:1px solid #D9DAD6;border-radius:14px;padding:clamp(20px,4vw,48px)}.other-category{font-weight:800;color:#76513F;font-size:13px}.other-sheet h1{font-size:clamp(26px,4vw,44px);line-height:1.3;overflow-wrap:anywhere}.other-cover{display:block;width:100%;height:auto;max-height:520px;object-fit:contain;border-radius:10px;margin:24px 0;background:#292B2D}.other-summary{font-size:16px;line-height:1.8}.other-placeholder{font-size:12px;color:#777}.other-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:24px}.other-actions a{display:inline-block;padding:12px 18px;background:#292B2D;border-radius:8px;color:#fff;text-decoration:none;font-weight:700}.other-actions a:hover{background:#55585A}
</style>
