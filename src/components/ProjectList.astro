---
import ProjectArtwork from './ProjectArtwork.astro';
import { copy, project, type Lang } from '../data/content';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = copy[lang];
const prefix = lang === 'ja' ? '' : '/en';
const detail = prefix + '/projects/' + project.id + '/';
const titleId = 'project-' + project.id + '-title';
---
<section class="project-row" aria-labelledby={titleId}>
  <ProjectArtwork lang={lang} variant="listing" detailUrl={detail} />
  <div class="project-info">
    <p class="project-meta">{t.game} / {t.browser}</p>
    <h2 id={titleId}><a href={detail}>{project.title}</a></h2>
    <p class="project-summary">{project.summary[lang]}</p>
    <a class="primary-link" href={detail}>{t.detail}<span aria-hidden="true"> →</span></a>
    <a class="source-link" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
      {t.source}<span aria-hidden="true"> ↗</span>
    </a>
  </div>
</section>
