---
import { games } from '../data/games';
import type { Lang } from '../data/content';
import HomeGameCard from './HomeGameCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ja = lang === 'ja';
const labels = ja ? {
  search: '作品名・キーワードで検索...', all: 'すべて', genre: 'ジャンル',
  format: 'カテゴリ', sort: '並び順', newest: '公開日の新しい順', updated: '更新日の新しい順',
  name: '名前順', clear: '条件をクリア', empty: '条件に一致する作品はありません。',
  count: 'の作品を表示しています🐾', game: 'Games', tool: 'Tools', content: 'Contents'
} : {
  search: 'Search projects...', all: 'All', genre: 'Genre',
  format: 'Category', sort: 'Sort by', newest: 'Newest release', updated: 'Recently updated',
  name: 'Name', clear: 'Clear filters', empty: 'No projects match your filters.',
  count: 'projects displayed 🐾', game: 'Games', tool: 'Tools', content: 'Contents'
};
const genres = [...new Set(games.map(game => game.genre[lang]))].sort((a,b) => a.localeCompare(b,lang));
const formats = [...new Set(games.map(game => game.format))];
const formatLabel = (format: string) => format === 'browser' ? (ja ? 'ブラウザゲーム' : 'Browser game') : (ja ? 'ダウンロードゲーム' : 'Download game');
---
<section class="catalog" data-catalog lang={lang}>
  <div class="catalog-filters" role="search" aria-label={ja ? '作品を探す' : 'Find projects'}>
    <label class="catalog-search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m16 16 5 5"/></svg><input data-search type="search" placeholder={labels.search} aria-label={labels.search} autocomplete="off"/></label>
    <div class="catalog-tabs" role="group" aria-label={ja ? 'カテゴリ' : 'Category'}>
      {[['all',labels.all],['games',labels.game],['tools',labels.tool],['contents',labels.content]].map(([value,label])=><button type="button" class="catalog-tab" data-category={value} aria-pressed={value==='all'}>{label}</button>)}
    </div>
    <div class="catalog-selects">
      <label><span>{labels.format}</span><select data-format><option value="all">{labels.all}</option>{formats.map(format=><option value={format}>{formatLabel(format)}</option>)}</select></label>
      <label><span>{labels.genre}</span><select data-genre><option value="all">{labels.all}</option>{genres.map(genre=><option value={genre}>{genre}</option>)}</select></label>
      <label><span>{labels.sort}</span><select data-sort><option value="newest">{labels.newest}</option><option value="updated">{labels.updated}</option><option value="name">{labels.name}</option></select></label>
    </div>
    <div class="catalog-filter-footer"><button type="button" data-clear>{labels.clear} <span aria-hidden="true">↺</span></button></div>
  </div>
  <p class="catalog-count" aria-live="polite"><span data-count>{games.length}</span> / {games.length}{ja ? labels.count : ` ${labels.count}`}</p>
  <div class="catalog-grid" data-grid>
    {games.map((game,index)=><div class="catalog-item" data-item data-index={index} data-category={game.category} data-genre={game.genre[lang]} data-format={game.format} data-released={game.releasedAt ?? ''} data-updated={game.updatedAt ?? ''} data-name={game.title} data-keywords={`${game.title} ${game.genre[lang]} ${game.summary[lang]} ${formatLabel(game.format)}`.toLocaleLowerCase()}><HomeGameCard game={game} lang={lang} showFeature={false} showAccess={true} analyticsSource="project_catalog"/></div>)}
  </div>
  <p class="catalog-empty" data-empty hidden>{labels.empty}</p>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-catalog]').forEach(catalog => {
    const search = catalog.querySelector<HTMLInputElement>('[data-search]')!;
    const genre = catalog.querySelector<HTMLSelectElement>('[data-genre]')!;
    const format = catalog.querySelector<HTMLSelectElement>('[data-format]')!;
    const sort = catalog.querySelector<HTMLSelectElement>('[data-sort]')!;
    const tabs = Array.from(catalog.querySelectorAll<HTMLButtonElement>('[data-category]'));
    const items = Array.from(catalog.querySelectorAll<HTMLElement>('[data-item]'));
    const grid = catalog.querySelector<HTMLElement>('[data-grid]')!;
    const count = catalog.querySelector<HTMLElement>('[data-count]')!;
    const empty = catalog.querySelector<HTMLElement>('[data-empty]')!;
    const clear = catalog.querySelector<HTMLButtonElement>('[data-clear]')!;
    const params = new URLSearchParams(window.location.search);
    let category = params.get('category') || 'all';
    if (!tabs.some(tab => tab.dataset.category === category)) category = 'all';
    const trackFilter = (action: string) => {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'project_filter_change', {
        filter_action: action,
        project_category: category,
        genre: genre.value,
        format: format.value,
        sort_order: sort.value
      });
    };
    const update = () => {
      tabs.forEach(tab => tab.setAttribute('aria-pressed', String(tab.dataset.category === category)));
      const query = search.value.trim().toLocaleLowerCase();
      let visible = 0;
      items.forEach(item => {
        const matches = (category === 'all' || item.dataset.category === category)
          && (genre.value === 'all' || item.dataset.genre === genre.value)
          && (format.value === 'all' || item.dataset.format === format.value)
          && (!query || (item.dataset.keywords || '').includes(query));
        item.hidden = !matches;
        if (matches) visible++;
      });
      const key = sort.value === 'updated' ? 'updated' : 'released';
      items.sort((a,b) => {
        if (sort.value === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '',catalog.lang);
        return (b.dataset[key] || '').localeCompare(a.dataset[key] || '') || Number(a.dataset.index) - Number(b.dataset.index);
      }).forEach(item => grid.appendChild(item));
      count.textContent = String(visible);
      empty.hidden = visible !== 0;
    };
    tabs.forEach(tab => tab.addEventListener('click', () => {
      category = tab.dataset.category || 'all';
      const url = new URL(window.location.href);
      if (category === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category',category);
      window.history.replaceState(null,'',url);
      update();
      trackFilter('category');
    }));
    [search,genre,format,sort].forEach(control => control.addEventListener('input',update));
    // Do not send typed keywords to analytics: they can contain personal information.
    let searchTimer: ReturnType<typeof setTimeout> | undefined;
    search.addEventListener('input', () => {
      if (searchTimer) clearTimeout(searchTimer);
      searchTimer = setTimeout(() => trackFilter('search'), 700);
    });
    [genre,format,sort].forEach(control => control.addEventListener('change', () => trackFilter(control.dataset.genre !== undefined ? 'genre' : control.dataset.format !== undefined ? 'format' : 'sort')));
    clear.addEventListener('click',() => {
      search.value = ''; genre.value = 'all'; format.value = 'all'; sort.value = 'newest'; category = 'all';
      const url = new URL(window.location.href); url.searchParams.delete('category');
      window.history.replaceState(null,'',url); update(); trackFilter('clear');
    });
    update();
  });
</script>
<style>
.catalog{margin:0 0 28px}.catalog-count{margin:0 0 14px;color:#777A7B;font-size:13px;font-weight:600}
.catalog-filters{background:#fff;border:1px solid #D9DAD6;border-radius:14px;padding:clamp(14px,2vw,22px);margin-bottom:22px}
.catalog-search{display:flex;align-items:center;gap:10px;border:1px solid #B7B9B6;border-radius:9px;padding:0 14px;background:#F9F9F7;min-height:46px}
.catalog-search:focus-within{outline:2px solid #B58A76;outline-offset:2px}
.catalog-search svg{width:18px;height:18px;fill:none;stroke:#777A7B;stroke-width:2;stroke-linecap:round}
.catalog-search input{width:100%;min-width:0;border:0;outline:0;background:transparent;font:inherit;font-size:14px;color:#292B2D}
.catalog-tabs{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}
.catalog-tab{border:1px solid #D9DAD6;background:#fff;color:#55585A;border-radius:999px;padding:8px 16px;font:inherit;font-size:12px;font-weight:700;cursor:pointer}
.catalog-tab[aria-pressed=true]{background:#292B2D;color:#fff;border-color:#292B2D}.catalog-tab:hover:not([aria-pressed=true]){border-color:#B58A76;background:#F9F5F1}
.catalog-selects{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}.catalog-selects label{display:flex;flex-direction:column;gap:6px;color:#777A7B;font-size:12px;font-weight:700}
.catalog-selects select{width:100%;min-width:0;padding:10px 12px;border:1px solid #B7B9B6;border-radius:8px;background:#fff;color:#292B2D;font:inherit;font-size:13px}
.catalog-filter-footer{display:flex;justify-content:flex-end;margin-top:12px}.catalog-filter-footer button{border:0;background:transparent;color:#55585A;text-decoration:underline;text-underline-offset:3px;font:inherit;font-size:12px;cursor:pointer;padding:5px}
.catalog-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px;align-items:stretch}.catalog-item{min-width:0}.catalog-item[hidden],.catalog-empty[hidden]{display:none}.catalog-item :global(.home-game-entry){height:100%;grid-template-columns:100px minmax(0,1fr)}.catalog-item :global(.home-game-entry:hover){transform:scale(1.025)}
.catalog-empty{text-align:center;padding:50px 20px;background:#fff;border:1px dashed #B7B9B6;border-radius:12px;color:#777A7B}
@media(max-width:760px){.catalog-grid{grid-template-columns:1fr}.catalog-selects{grid-template-columns:1fr 1fr}.catalog-selects label:last-child{grid-column:1/-1}.catalog-item :global(.home-game-entry){grid-template-columns:90px minmax(0,1fr)}}
@media(max-width:380px){.catalog-tabs{gap:5px}.catalog-tab{padding:7px 10px}.catalog-selects{grid-template-columns:1fr}.catalog-selects label:last-child{grid-column:auto}}
</style>
