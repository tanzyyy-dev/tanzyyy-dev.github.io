---
import Base from '../../layouts/Base.astro';
import ProjectDetail from '../../components/ProjectDetail.astro';
import {games} from '../../data/games';
export function getStaticPaths(){return games.map(game=>({params:{slug:game.slug},props:{game}}));}
const {game}=Astro.props;
---
<Base lang="ja" title={game.title} description={game.summary.ja}><ProjectDetail lang="ja" game={game}/></Base>
