---
import type {Lang} from '../data/content';
import {games, homepageGames} from '../data/games';
import HomeGameCard from './HomeGameCard.astro';
const featuredGames = homepageGames();
const hasMoreGames = games.filter(game => game.homeFeature).length > 3;
interface Props { lang: Lang }
const {lang}=Astro.props;
const ja=lang==='ja';
const prefix=ja?'':'/en';
const categories=[
 {id:'games',label:'GAMES',color:'#B58A76',glyph:'gamepad',latest:null},
 {id:'tools',label:'TOOLS',color:'#7C9C9B',glyph:'tool',latest:null},
 {id:'contents',label:'CONTENTS',color:'#A292BA',glyph:'book',latest:null},
 {id:'other',label:'OTHER',color:'#B2A16F',glyph:'shapes',latest:null}
] as const;
---
<section class="category-grid" aria-label={ja?'カテゴリ別の最新作品':'Latest work by category'}>
 {categories.map(category=><article class="category-card" style={`--category-accent:${category.color}`}>
  <div class="category-heading">
   <h2><svg class="category-paw" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="5" cy="8" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg><span class="category-name"><span class="category-initial">{category.label.charAt(0)}</span>{category.label.slice(1)}</span></h2>
   <span class="category-glyph" aria-hidden="true">
    {category.glyph==='gamepad'?<svg viewBox="0 0 24 24"><path d="M6.5 8h11a4 4 0 0 1 3.8 3l1.2 5a2.6 2.6 0 0 1-4.1 2.7l-2.8-2.2H8.4l-2.8 2.2A2.6 2.6 0 0 1 1.5 16l1.2-5a4 4 0 0 1 3.8-3Z"/><path d="M7 11v5m-2.5-2.5h5M16 12h.01M19 14h.01"/></svg>:category.glyph==='tool'?<svg viewBox="0 0 24 24"><path d="M14.7 6.1a5.5 5.5 0 0 0-7.3 7.3L2.7 18a2.3 2.3 0 0 0 3.3 3.3l4.7-4.7a5.5 5.5 0 0 0 7.3-7.3l-3.8 3.8-3.3-3.3Z"/></svg>:category.glyph==='book'?<svg viewBox="0 0 24 24"><path d="M12 6c-3-2-6.5-2-10-1v14c3.5-1 7-1 10 1 3-2 6.5-2 10-1V5c-3.5-1-7-1-10 1Zm0 0v14"/></svg>:<svg viewBox="0 0 24 24"><rect x="3" y="3" width="9" height="9" rx="1.5"/><circle cx="17.5" cy="7.5" r="4"/><path d="m10 15 5 7H5Z"/></svg>}
   </span>
  </div>
  {category.id==='games'?<div class="home-games-list">{featuredGames.length ? featuredGames.map(game=><HomeGameCard game={game} lang={lang}/>) : <p class="category-empty">{ja?'現在、掲載作品はありません。':'Nothing published here yet.'}</p>}</div>:category.id==='other'?<><nav class="other-links" style="display:flex;flex-direction:column;align-items:stretch;width:100%;min-width:0;box-sizing:border-box;gap:10px;flex:1;padding-top:6px" aria-label={ja?'外部サービス':'External profiles'}>
   <a class="other-link" style="display:flex;width:100%;min-width:0;box-sizing:border-box;align-items:center;gap:14px;min-height:94px;padding:12px 16px;border:1px solid #D9DAD6;border-radius:9px;text-decoration:none;color:#292B2D" href="https://x.com/tanzyto40" target="_blank" rel="noopener noreferrer"><span class="other-link-icon other-x" aria-hidden="true">𝕏</span><span class="other-link-copy"><strong>TanzyyyのX</strong><small>{ja?'IT、AI（SI）関連情報の他、近況や戯言ポストしてます🐾':'I post about IT, AI (SI), life updates, and random thoughts 🐾'}</small></span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
   <a class="other-link" style="display:flex;width:100%;min-width:0;box-sizing:border-box;align-items:center;gap:14px;min-height:82px;padding:14px 16px;border:1px solid #D9DAD6;border-radius:9px;text-decoration:none;color:#292B2D" href="https://qiita.com/tanzyto40" target="_blank" rel="noopener noreferrer"><span class="other-link-icon" aria-hidden="true"><img src="https://cdn.simpleicons.org/qiita/55C500" width="27" height="27" alt="" loading="lazy"/></span><span class="other-link-copy"><strong>TanzyyyのQiita</strong><small>{ja?'思い立ったら書き殴る気まぐれ更新🐾':'Occasional spur-of-the-moment technical writing 🐾'}</small></span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
   <a class="other-link" style="display:flex;width:100%;min-width:0;box-sizing:border-box;align-items:center;gap:14px;min-height:82px;padding:14px 16px;border:1px solid #D9DAD6;border-radius:9px;text-decoration:none;color:#292B2D" href="https://github.com/tanzyyy-dev" target="_blank" rel="noopener noreferrer"><span class="other-link-icon" aria-hidden="true"><svg width="27" height="27" viewBox="0 0 24 24"><path d="M9 19c-4.5 1.5-4.5-2.5-6-3m12 6v-3.6a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.4 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.7 1.4a12.8 12.8 0 0 0-6.7 0C5.8 1.7 4.6 2.1 4.6 2.1a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3 9.3c0 5.2 3.1 6.3 6.1 6.6a3.2 3.2 0 0 0-.9 2.5V22"/></svg></span><span class="other-link-copy"><strong>TanzyyyのGitHub</strong><small>{ja?'生成AI Slopの世界へようこそ🐾':'Welcome to the world of generative AI slop 🐾'}</small></span><svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>
  </nav><p class="other-free-comment">{ja?<>XやQiitaはお気軽にフォロー、コメントください🐾<br/>情報交換や雑談で絡める方、大歓迎です🐶</>:<>Feel free to follow or comment on X and Qiita 🐾<br/>Always happy to chat and exchange ideas 🐶</>}</p></>:<>
  <div class="category-cover" aria-hidden="true">
   {category.latest?.image?<img src={category.latest.image} alt="" loading="lazy" width="1200" height="630" style="width:100%;height:100%;object-fit:cover;display:block"/>:category.latest?<div class="category-cover-type"><small>GAME / 001</small><strong>THE<br/>HOLLYWOOD<br/>HACKER</strong><small>RHYTHM × KEYBOARD</small></div>:null}
  </div>
  <div class="category-content">
   {category.latest?<><p class="category-kicker">FEATURED <span>·</span> {category.latest.kind}</p><h3><a href={category.latest.href}>{category.latest.title}</a></h3><p class="category-description">{category.latest.description}</p></>:<p class="category-empty">{ja?'現在、掲載作品はありません。':'Nothing published here yet.'}</p>}
  </div>
  {(category.id!=='games' || hasMoreGames) && <a class="category-more" href={category.id==='games'?prefix+'/projects/':prefix+'/projects/?category='+category.id}>{ja?'もっと見る':'View more'} <svg class="category-more-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>}
  </>}
 </article>)}
</section>
<style>
.home-games-list{display:flex;flex-direction:column;gap:10px;min-height:0;flex:1;overflow:visible;padding:12px;margin:-10px}
.category-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(16px,2vw,28px)}
.category-card{height:clamp(440px,39vw,520px);min-width:0;display:flex;flex-direction:column;padding:clamp(18px,2.1vw,28px);background:#fff;border:1px solid #D9DAD6;border-radius:14px;overflow:hidden}
.category-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:18px}
.category-heading h2{margin:0;display:flex;align-items:center;gap:9px;color:#292B2D;font-family:"Baloo 2","Trebuchet MS",sans-serif;font-size:clamp(22px,2.1vw,27px);font-weight:800;line-height:1.1;letter-spacing:-.025em}
.category-name{display:inline-block;white-space:nowrap}.category-initial{font-size:1.5em}.category-paw{width:22px;height:22px;fill:var(--category-accent);flex:none;transform:rotate(-18deg)}
.category-glyph{display:flex;align-items:center;justify-content:center;width:38px;height:38px;flex:none}
.category-glyph svg{width:30px;height:30px;fill:none;stroke:var(--category-accent);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
:global(.other-links){display:flex;flex-direction:column;align-items:stretch;width:100%;min-width:0;gap:12px;flex:1;padding-top:6px}:global(.other-link){display:flex;width:100%;box-sizing:border-box;align-items:center;gap:14px;min-height:82px;padding:14px 16px;border:1px solid #D9DAD6;border-radius:9px;color:#292B2D;text-decoration:none;transition:background-color .18s,border-color .18s}:global(.other-link:hover){background:#F0EFEB;border-color:#777A7B}:global(.other-link:focus-visible){outline:2px solid #292B2D;outline-offset:3px}:global(.other-link-icon){width:32px;display:flex;align-items:center;justify-content:center;flex:none}:global(.other-x){font-size:26px;font-weight:700}:global(.other-link-icon img){width:27px;height:27px;display:block;object-fit:contain}:global(.other-link-icon svg){width:27px;height:27px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}:global(.other-link-copy){display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}:global(.other-link-copy strong){font-size:16px}:global(.other-link-copy small){font-size:12px;color:#777A7B;line-height:1.5;overflow-wrap:anywhere}:global(.other-link>svg){width:18px;height:18px;fill:none;stroke:#777A7B;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}.other-free-comment{margin:0;padding:14px 2px 0;color:#55585A;font-size:13px;line-height:1.8;border-top:1px solid #E2E3DF}.category-cover{height:clamp(138px,14vw,190px);flex:none;overflow:hidden;border-radius:7px;background:#E5E5E1}
.category-cover img{width:100%;height:100%;object-fit:cover;display:block}
.category-cover-type{height:100%;display:flex;flex-direction:column;justify-content:space-between;padding:14px 18px;background:#272A30;color:#F0EFEB}
.category-cover-type small{font-size:10px;letter-spacing:.14em}
.category-cover-type strong{font-family:Arial,sans-serif;font-size:clamp(21px,2.7vw,38px);line-height:.88;letter-spacing:-.065em}
.category-content{flex:1;min-height:0;padding-top:16px}
.category-kicker{margin:0 0 7px;font-size:11px;letter-spacing:.1em;font-weight:800;color:#777A7B}
.category-kicker span{color:var(--category-accent)}
.category-content h3{font-size:clamp(18px,2vw,24px);line-height:1.25;letter-spacing:-.035em;margin:0 0 9px;overflow-wrap:anywhere}
.category-content h3 a{text-decoration:none}
.category-content h3 a:hover{text-decoration:underline}
.category-description{font-size:14px;line-height:1.65;color:#55585A;margin:0;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.category-empty{color:#777A7B;font-size:14px;margin:4px 0 0}
.category-more{display:flex;align-items:center;justify-content:space-between;gap:8px;flex:none;min-height:46px;padding:10px 14px;border:1px solid #777A7B;border-radius:8px;color:#292B2D;background:#fff;text-decoration:none;font-size:14px;font-weight:700;transition:background-color .18s,border-color .18s}
.category-more:hover{background:#F0EFEB;border-color:#292B2D}
.category-more-chevron{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
@media(max-width:760px){.category-grid{grid-template-columns:minmax(0,1fr);gap:16px}.category-card{height:460px;padding:20px}.category-cover{height:168px}.category-cover-type strong{font-size:31px}.category-heading h2{font-size:26px}}
</style>
