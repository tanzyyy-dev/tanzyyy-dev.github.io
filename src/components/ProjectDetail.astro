---
import ProjectArtwork from './ProjectArtwork.astro';
import { copy, project, type Lang } from '../data/content';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = copy[lang];
const home = lang === 'ja' ? '/' : '/en/';
---
<div class="wrap page">
  <p><a href={home}>← {t.back}</a></p>
  <p class="eyebrow">{t.game} / {t.browser}</p>
  <h1>{project.title}</h1>
  <p class="lead">{project.summary[lang]}</p>
  <ProjectArtwork lang={lang} variant="detail" />
  <div class="actions">
    {
      project.demoUrl ? (
        <a class="button" href={project.demoUrl}>{t.play} ↗</a>
      ) : (
        <p class="notice">{t.demoUnavailable}</p>
      )
    }
    <a class="button" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">
      {t.source} ↗
    </a>
  </div>
  <section class="section">
    <h2>{t.projectAbout}</h2>
    <p>{project.description[lang]}</p>
  </section>
</div>
