---
import '../styles/global.css';
import {copy, type Lang} from '../data/content';
interface Props {lang:Lang; title?:string; description?:string}
const {lang,title,description}=Astro.props;
const t=copy[lang];
const path=Astro.url.pathname;
const alternate=lang==='ja'?'/en'+(path==='/'?'/':path):(path.replace(/^\/en(?=\/)/,'')||'/');
const origin='https://tanzyyy-dev.github.io';
const canonical=new URL(path,origin).href;
const otherUrl=new URL(alternate,origin).href;
const home=lang==='ja'?'/':'/en/';
const prefix=lang==='ja'?'':'/en';
const isProjects=path===prefix+'/projects/' || path.startsWith(prefix+'/projects/');
const isAbout=path===prefix+'/about/';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@800&display=swap" rel="stylesheet"/>
<title>{title?title+' | tanzyyy-dev':'tanzyyy-dev | Projects'}</title>
<meta name="description" content={description??t.intro}/>
<link rel="canonical" href={canonical}/>
<link rel="alternate" hreflang="ja" href={lang==='ja'?canonical:otherUrl}/>
<link rel="alternate" hreflang="en" href={lang==='en'?canonical:otherUrl}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title??'tanzyyy-dev'}/>
<meta property="og:description" content={description??t.intro}/><meta property="og:url" content={canonical}/>
</head>
<body class:list={{"home-palette":path===home}}>
<a class="skip" href="#main">{lang==='ja'?'本文へ移動':'Skip to content'}</a>
<header><div class="wrap header-inner"><a class="brand" href={home} aria-current={path===home?'page':undefined} aria-label="tanzyyy-dev"><span class="brand-letters" aria-hidden="true">{[..."tanzyyy-dev"].map((letter, index) => <span class:list={["brand-letter", {"brand-letter-emphasis":index===0 || index===8, "brand-letter-small":index===3 || index===4}]} style={`--order:${10 - index}`}>{letter}</span>)}</span><span class="brand-dog-icons" aria-hidden="true"><svg class="brand-schnauzer" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 10 6 4 7 24 13 31 18 41 24 45 30 41 35 31 41 24 42 4 35 10 30 7 24 10 18 7Z" fill="#B7B9B6" stroke="#F0EFEB" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 21 21 18M27 18 34 21" stroke="#292B2D" stroke-width="4" stroke-linecap="round"/><path d="M17 25h2m10 0h2" stroke="#292B2D" stroke-width="2.8" stroke-linecap="round"/><path d="m12 29 7-1 5 5 5-5 7 1-5 10-7 6-7-6Z" fill="#F0EFEB"/><path d="m20 30 4 3 4-3-4-2Z" fill="#292B2D"/><path d="M24 33v5m-4-1 4 2 4-2" stroke="#777A7B" stroke-width="1.5" stroke-linecap="round"/></svg><svg class="brand-paw" viewBox="0 0 24 24" fill="#B7B9B6" xmlns="http://www.w3.org/2000/svg"><ellipse cx="5" cy="8" rx="2" ry="3" transform="rotate(-20 5 8)"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3" transform="rotate(15 16 6)"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6" transform="rotate(25 20 10)"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg></span></a><nav aria-label={lang==='ja'?'メインナビゲーション':'Main navigation'}><a href={prefix+'/projects/'} class:list={{active:isProjects}} aria-current={isProjects?'page':undefined}>{t.projects}</a><a href={prefix+'/about/'} class:list={{active:isAbout}} aria-current={isAbout?'page':undefined}>{t.about}</a><a href={alternate} lang={lang==='ja'?'en':'ja'}>{lang==='ja'?'EN':'日本語'}</a></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="wrap foot"><span>© {new Date().getFullYear()} tanzyyy-dev</span><a href="https://github.com/tanzyyy-dev">GitHub</a></div></footer>
</body></html>
