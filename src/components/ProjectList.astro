---
import {copy,project,type Lang} from '../data/content';
interface Props {lang:Lang}
const {lang}=Astro.props;
const t=copy[lang];
const prefix=lang==='ja'?'':'/en';
const detail=prefix+'/projects/hackhackhack/';
---
<section class="project-row" aria-labelledby="featured-project-title">
  <a class="art" href={detail} aria-label={project.title+' — '+t.detail}>
    <span class="art-label">GAME / 001</span>
    <strong>THE<br/>HOLLYWOOD<br/>HACKER</strong>
    <small>RHYTHM × KEYBOARD</small>
  </a>
  <div class="project-info">
    <p class="project-meta">{t.categories[1]}</p>
    <h2 id="featured-project-title"><a href={detail}>{project.title}</a></h2>
    <p class="project-summary">{project.summary[lang]}</p>
    <a class="primary-link" href={detail}>{t.detail}</a>
    <a class="source-link" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer">{t.source}</a>
  </div>
</section>
