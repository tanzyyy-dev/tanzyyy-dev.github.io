---
import type { Lang } from '../data/content';
import type { Tool, Content } from '../data/types';
import { availabilityStatusLabels } from '../data/games';
import Breadcrumbs from './Breadcrumbs.astro';
interface Props { lang: Lang; project: Tool | Content }
const { lang, project } = Astro.props;
const ja = lang === 'ja';
const prefix = ja ? '' : '/en';
const media = project.media[0];
const category = project.category === 'tools' ? 'Tools' : 'Contents';
const dateLabel = (date: string) => new Intl.DateTimeFormat(ja ? 'ja-JP' : 'en-US', {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(date+'T00:00:00Z'));
const updateLines = project.updateNotes.map(note => note[lang].trim()).filter(Boolean).slice(0, 3);
const updateSlots = Array.from({ length: 3 }, (_, index) => updateLines[index] ?? '—');
const content = project.category === 'contents' ? project : null;
const notes = content?.notes?.map(note => note[lang].trim()).filter(Boolean) ?? [];
---
<article class="wrap page game-detail">
  <Breadcrumbs lang={lang} items={[{ label: ja ? 'ホーム' : 'Home', href: prefix + '/' }, { label: ja ? '作品一覧' : 'Projects', href: prefix + '/projects/' }, { label: project.title }]} />
  <div class="game-sheet">
    <div class="game-sheet-heading">
      <h1 class="game-title-with-status"><span class={`availability-badge status-${project.availabilityStatus}`}>{availabilityStatusLabels[project.availabilityStatus][lang]}</span><span>{project.title}</span></h1>
      <div class="game-category">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><ellipse cx="5" cy="8" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg>
        <span><strong>{category[0]}</strong>{category.slice(1).toUpperCase()}</span>
      </div>
    </div>
    <div class="game-featured">
      <figure class="game-cover">
        {media?.type === 'video'
          ? <video controls preload="metadata" poster={media.poster} aria-label={media.alt[lang]}><source src={media.src}/></video>
          : media?.type === 'image'
            ? <img src={media.src} alt={media.alt[lang]} width="1200" height="630" loading="eager" decoding="async"/>
            : <div class="game-media-empty">{ja ? '作品画像準備中' : 'Project image coming soon'}</div>}
        {media?.placeholder && <figcaption class="game-media-note">{ja ? '※ 仮画像です' : 'Placeholder artwork'}</figcaption>}
      </figure>
      <div class="game-overview">
        <section class="game-info-card" aria-label={ja ? '作品情報' : 'Project information'}>
          {project.repositoryUrl && <a class="game-repo-icon" href={project.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={ja ? 'GitHubでソースコードを見る' : 'View source code on GitHub'} title={ja ? 'GitHubでソースコードを見る' : 'View source on GitHub'}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 19c-4.5 1.5-4.5-2.5-6-3m12 6v-3.6a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.4 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.7 1.4a12.8 12.8 0 0 0-6.7 0C5.8 1.7 4.6 2.1 4.6 2.1a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3 9.3c0 5.2 3.1 6.3 6.1 6.6a3.2 3.2 0 0 0-.9 2.5V22"/></svg></a>}
          <div class="game-info-grid">
            <div class="game-info-field"><span class="game-info-label">{ja ? 'カテゴリ' : 'Category'}</span><strong>{content?.categoryLabel?.[lang] ?? category}</strong></div>
            <div class="game-info-field"><span class="game-info-label">{ja ? 'ジャンル' : 'Genre'}</span><strong>{content?.genre?.[lang] ?? '—'}</strong></div>
            <div class="game-info-field"><span class="game-info-label">{ja ? 'バージョン' : 'Version'}</span><strong>{project.version || '—'}</strong></div>
            <div class="game-info-field"><span class="game-info-label">{ja ? '公開記事数' : 'Published articles'}</span><strong>{content?.publishedCount != null ? (ja ? `${content.publishedCount}本` : `${content.publishedCount} articles`) : '—'}</strong></div>
            <div class="game-info-field"><span class="game-info-label">{ja ? 'リリース日' : 'Released'}</span>{project.releasedAt ? <time datetime={project.releasedAt}>{dateLabel(project.releasedAt)}</time> : <span class="game-date-unset">—</span>}</div>
            <div class="game-info-field"><span class="game-info-label">{ja ? '最終更新日' : 'Last updated'}</span>{project.updatedAt ? <time datetime={project.updatedAt}>{dateLabel(project.updatedAt)}</time> : <span class="game-date-unset">—</span>}</div>
          </div>
          <p class="game-info-summary">{project.summary[lang]}</p>
          <div class="game-info-update">
            <span class="game-info-label">{ja ? '主なアップデート' : 'What’s new'}</span>
            <ul class="game-info-update-lines">{updateSlots.map(line => <li>{line}</li>)}</ul>
          </div>
          <div class="game-info-notes">
            <span class="game-info-label">{ja ? '備考' : 'Notes'}</span>
            <ul class="game-info-notes-list">{(notes.length ? notes : ['—']).map(line => <li>{line}</li>)}</ul>
          </div>
        </section>
        <div class="game-actions">
          {project.availabilityStatus === 'active' && project.url
            ? <a class="game-play" data-ga-event="project_open_click" data-ga-source="project_detail" data-ga-project={project.slug} href={project.url} target="_blank" rel="noopener noreferrer"><span>{ja ? '作品を開く' : 'Open project'}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
            : <button class="game-play game-play-disabled" type="button" disabled><span>{ja ? '作品を開く' : 'Open project'}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></button>}
        </div>
      </div>
    </div>
  </div>
</article>
