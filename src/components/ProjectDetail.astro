---
import type { Lang } from '../data/content';
import type { Game } from '../data/games';
interface Props { lang: Lang; game: Game }
const {lang, game} = Astro.props;
const ja = lang === 'ja';
const prefix = ja ? '' : '/en';
const media = game.media[0];
const dateLabel = (date: string) => new Intl.DateTimeFormat(ja ? 'ja-JP' : 'en-US', {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(date+'T00:00:00Z'));
---
<article class="wrap page game-detail">
  <nav class="game-breadcrumb" aria-label={ja?'現在位置':'Breadcrumb'}>
    <a href={prefix+'/'}>{ja?'ホーム':'Home'}</a><span aria-hidden="true">/</span>
    <a href={prefix+'/projects/'}>{ja?'作品一覧':'Projects'}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{game.title}</span>
  </nav>
  <div class="game-sheet">
    <div class="game-sheet-heading">
      <div class="game-category">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><ellipse cx="5" cy="8" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg>
        <span><strong>G</strong>AMES</span>
      </div>
    </div>
    <div class="game-featured">
      <figure class="game-cover">
        {media?.type==='video'
          ? <video controls preload="metadata" poster={media.poster} aria-label={media.alt[lang]}><source src={media.src}/></video>
          : media?.type==='image'
            ? <img src={media.src} alt={media.alt[lang]} width="1200" height="630" loading="eager" decoding="async"/>
            : <div class="game-media-empty">{ja?'プレイ画像準備中':'Gameplay image coming soon'}</div>}
        {media?.placeholder && <figcaption class="game-media-note">{ja?'※ 仮画像：プレイ画面は後日掲載予定':'Placeholder artwork — gameplay capture coming soon'}</figcaption>}
      </figure>
      <div class="game-overview">
        <h1>{game.title}</h1>
        <section class="game-info-card" aria-label={ja?'作品情報':'Game information'}>
          <div class="game-info-grid">
            <div class="game-info-field">
              <span class="game-info-label">{ja?'形式':'Format'}</span>
              <strong>{game.format==='browser'?(ja?'ブラウザゲーム':'Browser game'):(ja?'ダウンロードゲーム':'Download game')}</strong>
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'ジャンル':'Genre'}</span>
              <strong>{game.genre[lang]}</strong>
            </div>
            <div class="game-info-field game-info-devices">
              <span class="game-info-label">{ja?'対応端末':'Devices'}</span>
              <div class="game-devices">
                {game.devices.includes('pc') && <span title="PC" aria-label="PC"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></span>}
                {game.devices.includes('tablet') && <span title={ja?'タブレット':'Tablet'} aria-label={ja?'タブレット':'Tablet'}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M11 19h2"/></svg></span>}
                {game.devices.includes('smartphone') && <span title={ja?'スマホ':'Phone'} aria-label={ja?'スマホ':'Phone'}><svg viewBox="0 0 24 24" width="16" height="18" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 19h2"/></svg></span>}
              </div>
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'リリース日':'Released'}</span>
              {game.releasedAt ? <time datetime={game.releasedAt}>{dateLabel(game.releasedAt)}</time> : <span class="game-date-unset">—</span>}
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'最終更新日':'Last updated'}</span>
              {game.updatedAt ? <time datetime={game.updatedAt}>{dateLabel(game.updatedAt)}</time> : <span class="game-date-unset">—</span>}
            </div>
          </div>
          <p class="game-info-summary">{game.summary[lang]}</p>
          {(game.notices?.length ?? 0)>0 && <div class="game-info-notes">
            <span class="game-info-label">{ja?'備考':'Notes'}</span>
            <div class="game-info-notes-list">
              {game.notices?.map(notice=><p><svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M7 16h10"/></svg><span>{notice.text[lang]}</span></p>)}
            </div>
          </div>}
        </section>
        <div class="game-actions"><a class="game-play" href={game.playUrl} target="_blank" rel="noopener noreferrer"><span>{ja?'ゲームをプレイ':'Play the game'}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
        {game.repositoryUrl && <a class="game-repo-icon" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={ja?'GitHubでソースコードを見る':'View source code on GitHub'} title={ja?'GitHubでソースコードを見る':'View source on GitHub'}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 19c-4.5 1.5-4.5-2.5-6-3m12 6v-3.6a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.4 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.7 1.4a12.8 12.8 0 0 0-6.7 0C5.8 1.7 4.6 2.1 4.6 2.1a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3 9.3c0 5.2 3.1 6.3 6.1 6.6a3.2 3.2 0 0 0-.9 2.5V22"/></svg></a>}</div>
      </div>
    </div>
  </div>
</article>
