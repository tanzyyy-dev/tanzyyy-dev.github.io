---
import '../styles/global.css';
import {copy, type Lang} from '../data/content';
interface Props {lang:Lang; title?:string; description?:string}
const {lang,title,description}=Astro.props;
const t=copy[lang];
const path=Astro.url.pathname;
const alternate=lang==='ja'?'/en'+(path==='/'?'/':path):(path.replace(/^\/en(?=\/)/,'')||'/');
const origin='https://tanzyyy-dev.github.io';
const canonical=new URL(path,origin).href;
const otherUrl=new URL(alternate,origin).href;
const home=lang==='ja'?'/':'/en/';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@800&display=swap" rel="stylesheet"/>
<title>{title?title+' | tanzyyy-dev':'tanzyyy-dev | Projects'}</title>
<meta name="description" content={description??t.intro}/>
<link rel="canonical" href={canonical}/>
<link rel="alternate" hreflang="ja" href={lang==='ja'?canonical:otherUrl}/>
<link rel="alternate" hreflang="en" href={lang==='en'?canonical:otherUrl}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title??'tanzyyy-dev'}/>
<meta property="og:description" content={description??t.intro}/><meta property="og:url" content={canonical}/>
</head>
<body class:list={{"home-palette":path===home}}>
<a class="skip" href="#main">{lang==='ja'?'本文へ移動':'Skip to content'}</a>
<header><div class="wrap header-inner"><a class="brand" href={home} aria-current={path===home?'page':undefined} aria-label="tanzyyy-dev"><span class="brand-letters" aria-hidden="true">{[..."tanzyyy-dev"].map((letter, index) => <span class:list={["brand-letter", {"brand-letter-emphasis":index===0}]} style={`--order:${10 - index}`}>{letter}</span>)}</span><span class="brand-paw-cluster" aria-hidden="true"><svg viewBox="0 0 28 28" width="28" height="28" xmlns="http://www.w3.org/2000/svg"><defs><g id="paw-mark" fill="#B7B9B6"><ellipse cx="5" cy="7" rx="2.6" ry="3.4"/><ellipse cx="11" cy="4" rx="2.6" ry="3.4"/><ellipse cx="17" cy="7" rx="2.6" ry="3.4"/><path d="M4 18Q5 12 11 12Q17 12 19 18Q20 22 16 22Q13 20 11 20Q8 20 6 22Q2 22 4 18Z"/></g></defs><use href="#paw-mark" transform="translate(4 14) rotate(-25 5 5) scale(.42)"/><use href="#paw-mark" transform="translate(15 5) rotate(20 5 5) scale(.38)"/><use href="#paw-mark" transform="translate(17 19) rotate(-15 5 5) scale(.29)"/></svg></span></a><nav class="language-switcher" aria-label="Language"><span class="language-label">language</span><div class="language-options" role="group" aria-label="Language selection"><a href={lang==='ja'?path:alternate} lang="ja" hreflang="ja" aria-label="日本語" aria-current={lang==='ja'?'true':undefined} class:list={{'language-option':true,'is-selected':lang==='ja'}}>JP</a><a href={lang==='en'?path:alternate} lang="en" hreflang="en" aria-label="English" aria-current={lang==='en'?'true':undefined} class:list={{'language-option':true,'is-selected':lang==='en'}}>EN</a></div></nav></div></header>
<main id="main"><slot/></main>
<footer><div class="wrap foot"><span>© {new Date().getFullYear()} tanzyyy-dev</span></div></footer>
</body></html>
