---
import type { Lang } from '../data/content';
import type { Game } from '../data/games';
interface Props { lang: Lang; game: Game }
const { lang, game } = Astro.props;
const ja = lang === 'ja';
const MAX_UPDATE_LINES = 3;
const updateLines = (game.updateNotes ?? [])
  .map(note => note[lang].trim())
  .filter(Boolean)
  .slice(0, MAX_UPDATE_LINES);
const updateSlots = Array.from({ length: MAX_UPDATE_LINES }, (_, index) => updateLines[index] ?? '—');
const dateLabel = (date: string) => new Intl.DateTimeFormat(ja ? 'ja-JP' : 'en-US', {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'}).format(new Date(date+'T00:00:00Z'));
---
<section class="game-info-card" aria-label={ja?'作品情報':'Game information'}>
        {game.repositoryUrl && <a class="game-repo-icon" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer" aria-label={ja?'GitHubでソースコードを見る':'View source code on GitHub'} title={ja?'GitHubでソースコードを見る':'View source on GitHub'}><svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M9 19c-4.5 1.5-4.5-2.5-6-3m12 6v-3.6a3.2 3.2 0 0 0-.9-2.5c3-.3 6.1-1.4 6.1-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.2-.4-3.7 1.4a12.8 12.8 0 0 0-6.7 0C5.8 1.7 4.6 2.1 4.6 2.1a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3 9.3c0 5.2 3.1 6.3 6.1 6.6a3.2 3.2 0 0 0-.9 2.5V22"/></svg></a>}
          <div class="game-info-grid">
            <div class="game-info-field">
              <span class="game-info-label">{ja?'カテゴリ':'Category'}</span>
              <strong>{game.format==='browser'?(ja?'ブラウザゲーム':'Browser game'):(ja?'ダウンロードゲーム':'Download game')}</strong>
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'ジャンル':'Genre'}</span>
              <strong>{game.genre[lang]}</strong>
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'バージョン':'Version'}</span>
              <strong>{game.version || '—'}</strong>
            </div>
            <div class="game-info-field game-info-devices">
              <span class="game-info-label">{ja?'対応端末':'Devices'}</span>
              <div class="game-devices">
                {game.devices.includes('pc') && <span title="PC" aria-label="PC"><svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8m-4-4v4"/></svg></span>}
                {game.devices.includes('tablet') && <span title={ja?'タブレット':'Tablet'} aria-label={ja?'タブレット':'Tablet'}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="2" width="14" height="20" rx="2"/><path d="M11 19h2"/></svg></span>}
                {game.devices.includes('smartphone') && <span title={ja?'スマホ':'Phone'} aria-label={ja?'スマホ':'Phone'}><svg viewBox="0 0 24 24" width="16" height="18" aria-hidden="true"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 19h2"/></svg></span>}
              </div>
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'リリース日':'Released'}</span>
              {game.releasedAt ? <time datetime={game.releasedAt}>{dateLabel(game.releasedAt)}</time> : <span class="game-date-unset">—</span>}
            </div>
            <div class="game-info-field">
              <span class="game-info-label">{ja?'最終更新日':'Last updated'}</span>
              {game.updatedAt ? <time datetime={game.updatedAt}>{dateLabel(game.updatedAt)}</time> : <span class="game-date-unset">—</span>}
            </div>
          </div>
          <p class="game-info-summary">{game.summary[lang]}</p>
          <div class="game-info-update">
            <span class="game-info-label">{ja?'主なアップデート':'What’s new'}</span>
            <ul class="game-info-update-lines">
              {updateSlots.map(line => <li>{line}</li>)}
            </ul>
          </div>
          {(game.notices?.length ?? 0)>0 && <div class="game-info-notes">
            <span class="game-info-label">{ja?'備考':'Notes'}</span>
            <ul class="game-info-notes-list">
              {game.notices?.map(notice => <li>{notice.text[lang]}</li>)}
            </ul>
          </div>}
        </section>
