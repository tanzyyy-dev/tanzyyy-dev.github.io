---
import type { Lang } from '../data/content';
import type { Game } from '../data/games';
interface Props { lang: Lang; game: Game }
const {lang, game} = Astro.props;
const ja = lang === 'ja';
const prefix = ja ? '' : '/en';
const media = game.media[0];
const deviceNames: Record<Game['devices'][number],Record<Lang,string>> = {
  pc:{ja:'PC',en:'PC'},tablet:{ja:'タブレット',en:'Tablet'},smartphone:{ja:'スマホ',en:'Phone'}
};
---
<article class="wrap page game-detail">
  <nav class="game-breadcrumb" aria-label={ja?'現在位置':'Breadcrumb'}>
    <a href={prefix+'/'}>{ja?'ホーム':'Home'}</a><span aria-hidden="true">/</span>
    <a href={prefix+'/projects/'}>{ja?'作品一覧':'Projects'}</a><span aria-hidden="true">/</span>
    <span aria-current="page">{game.title}</span>
  </nav>
  <div class="game-sheet">
    <div class="game-sheet-heading">
      <div class="game-category">
        <svg viewBox="0 0 24 24" width="21" height="21" aria-hidden="true"><ellipse cx="5" cy="8" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg>
        <span><strong>G</strong>AMES</span>
      </div>
      <span class="game-version">{game.format==='browser'?(ja?'ブラウザゲーム':'Browser game'):(ja?'ダウンロードゲーム':'Download game')}</span>
    </div>
    <div class="game-featured">
      <figure class="game-cover">
        {media?.type==='video'
          ? <video controls preload="metadata" poster={media.poster} aria-label={media.alt[lang]}><source src={media.src}/></video>
          : media?.type==='image'
            ? <img src={media.src} alt={media.alt[lang]} width="1200" height="630" loading="eager" decoding="async"/>
            : <div class="game-media-empty">{ja?'プレイ画像準備中':'Gameplay image coming soon'}</div>}
        {media?.placeholder && <figcaption class="game-media-note">{ja?'※ 仮画像：プレイ画面は後日掲載予定':'Placeholder artwork — gameplay capture coming soon'}</figcaption>}
      </figure>
      <div class="game-overview">
        <h1>{game.title}</h1>
        <div class="game-metadata">
          <span class="game-genre">{game.genre[lang]}</span>
          <span>{game.devices.map(device=>deviceNames[device][lang]).join(' / ')}</span>
        </div>
        <p class="game-description">{game.summary[lang]}</p>
        {game.requirements[lang].length > 0 && <div class="game-requirement" role="note">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M6 9h.01M10 9h.01M14 9h.01M18 9h.01M6 13h.01M10 13h.01M14 13h.01M18 13h.01M7 16h10"/></svg>
          <div><strong>{ja?'プレイに必要なもの':'Before you play'}</strong>{game.requirements[lang].map(req=><p>{req}</p>)}</div>
        </div>}
        <a class="game-play" href={game.playUrl} target="_blank" rel="noopener noreferrer"><span>{ja?'ゲームをプレイ':'Play the game'}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>
        {game.repositoryUrl && <a class="game-repo" href={game.repositoryUrl} target="_blank" rel="noopener noreferrer"><span>{ja?'GitHubで作品を見る':'View project on GitHub'}</span><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m9 5 7 7-7 7"/></svg></a>}
      </div>
    </div>
    <div class="game-sheet-footer"><a href={prefix+'/projects/'}>{ja?'← 作品一覧に戻る':'← Back to projects'}</a></div>
  </div>
</article>
