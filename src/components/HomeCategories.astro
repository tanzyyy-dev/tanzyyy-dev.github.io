---
import type { Lang } from '../data/content';
import { projects, projectCounts } from '../data/projects';
import HomeGameCard from './HomeGameCard.astro';
import OtherProjectCard from './OtherProjectCard.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ja = lang === 'ja';
const prefix = ja ? '' : '/en';
const works = [
  { id: 'games', label: 'Games', count: projectCounts.games, accent: '#B58A76', icon: '🎮' },
  { id: 'tools', label: 'Tools', count: projectCounts.tools, accent: '#7C9C9B', icon: '🛠' },
  { id: 'contents', label: 'Contents', count: projectCounts.contents, accent: '#A292BA', icon: '📖' }
];
const news = projects.filter(project => project.homeFeature).map(project => ({
  project, feature: project.homeFeature!,
  date: project.homeFeature === 'new-release' ? project.releasedAt : project.homeFeature === 'update' ? project.updatedAt : null,
  description: project.summary[lang]
})).sort((a,b) => {
  const priority = { 'new-release':0, update:1, recommended:2 };
  return priority[a.feature] - priority[b.feature] || (b.date || '').localeCompare(a.date || '');
});
const paw = '<svg viewBox="0 0 24 24" width="23" height="23" style="width:23px;height:23px;flex:none;fill:var(--accent);transform:rotate(-18deg)" aria-hidden="true"><ellipse cx="5" cy="8" rx="2" ry="3"/><ellipse cx="10" cy="5" rx="2" ry="3"/><ellipse cx="16" cy="6" rx="2" ry="3"/><ellipse cx="20" cy="10" rx="1.8" ry="2.6"/><path d="M12 11c-3 0-3.7 2.6-6 4.6-2.5 2.1-1 5.4 2 5.4 2.1 0 2.7-1 4-1s2 .9 4 1c3 .1 4.5-3.3 2-5.4-2.3-2-3-4.6-6-4.6Z"/></svg>';
---
<div class="home-sections">
  <section class="home-panel" style="--accent:#B58A76" aria-labelledby="news-heading">
    <h2 id="news-heading" class="section-heading"><Fragment set:html={paw}/> News</h2>
    <div class="news-list" data-news-list>
      {news.map((item,index) => <div class="news-entry" data-news-item data-news-date={item.date || ''} data-news-feature={item.feature} data-news-index={index}>
        {item.project.category === 'games' ? <HomeGameCard game={item.project} lang={lang} showAccess={true} analyticsSource="home_news"/> : <OtherProjectCard project={item.project} lang={lang} analyticsSource="home_news"/>}
      </div>)}
      <p class="empty-message" data-news-empty hidden>{ja ? '現在、お知らせはありません。' : 'No news at the moment.'}</p>
    </div>
    <button type="button" class="section-more" data-ga-event="news_expand" data-ga-source="home_news" data-news-toggle disabled aria-expanded="false"><span data-news-toggle-text>{ja ? 'お知らせをもっと見る' : 'Show more news'}</span><span aria-hidden="true" class="chevron">›</span></button>
  </section>
  <section class="home-panel" style="--accent:#7C9C9B" aria-labelledby="works-heading">
    <h2 id="works-heading" class="section-heading"><Fragment set:html={paw}/> Works</h2>
    <div class="works-grid">
      {works.map(work => <a class="work-entry interactive-card" data-ga-event="works_category_click" data-ga-source="home_works" data-ga-category={work.id} href={`${prefix}/projects/?category=${work.id}`} style={`--work-accent:${work.accent}`}>
        <span class="work-icon" aria-hidden="true">{work.icon}</span>
        <strong>{work.label}</strong>
        <span class="work-count">{work.count} {ja ? '作品' : work.count === 1 ? 'project' : 'projects'}</span>
      </a>)}
    </div>
    <a class="section-more interactive-card" data-ga-event="works_browse_click" data-ga-source="home_works" href={`${prefix}/projects/`}><span>{ja ? '作品一覧から探す' : 'Browse all projects'}</span><span class="chevron" aria-hidden="true">›</span></a>
  </section>
  <section class="home-panel" style="--accent:#A292BA" aria-labelledby="other-heading">
    <h2 id="other-heading" class="section-heading"><Fragment set:html={paw}/> Other</h2>
    <div class="other-grid">
      <a class="other-entry interactive-card" href="https://x.com/tanzyto40" data-ga-event="external_link_click" data-ga-source="home_other" data-ga-destination="x" target="_blank" rel="noopener noreferrer"><span class="other-symbol">𝕏</span><span><strong>TanzyyyのX</strong><small>{ja ? 'IT・AIの話や近況を投稿しています🐾' : 'IT, AI, and everyday updates 🐾'}</small></span><span class="chevron" aria-hidden="true">›</span></a>
      <a class="other-entry interactive-card" href="https://qiita.com/tanzyto40" data-ga-event="external_link_click" data-ga-source="home_other" data-ga-destination="qiita" target="_blank" rel="noopener noreferrer"><span class="other-symbol qiita">Q</span><span><strong>TanzyyyのQiita</strong><small>{ja ? '気まぐれに書く技術記事🐾' : 'Occasional technical articles 🐾'}</small></span><span class="chevron" aria-hidden="true">›</span></a>
      <a class="other-entry interactive-card" href="https://github.com/tanzyyy-dev" data-ga-event="external_link_click" data-ga-source="home_other" data-ga-destination="github" target="_blank" rel="noopener noreferrer"><span class="other-symbol">⌘</span><span><strong>TanzyyyのGitHub</strong><small>{ja ? '制作物やコードを公開しています🐾' : 'Projects and source code 🐾'}</small></span><span class="chevron" aria-hidden="true">›</span></a>
    </div>
    <p class="other-free-comment">{ja ? <>XやQiitaはお気軽にフォロー、コメントください🐾<br/>情報交換や雑談で絡める方、大歓迎です🐶</> : <>Feel free to follow or comment on X and Qiita 🐾<br/>Always happy to chat and exchange ideas 🐶</>}</p>
  </section>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-news-list]').forEach(list => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('[data-news-item]'));
    const toggle = list.parentElement?.querySelector<HTMLButtonElement>('[data-news-toggle]');
    const label = toggle?.querySelector<HTMLElement>('[data-news-toggle-text]');
    const empty = list.querySelector<HTMLElement>('[data-news-empty]');
    const ja = document.documentElement.lang.startsWith('ja');
    const now = Date.now();
    const active = items.filter(item => {
      if (item.dataset.newsFeature === 'recommended') return true;
      const date = item.dataset.newsDate;
      if (!date) return false;
      const start = Date.parse(date + 'T00:00:00Z');
      return Number.isFinite(start) && now >= start && now < start + 14 * 24 * 60 * 60 * 1000;
    });
    items.forEach(item => { item.hidden = !active.includes(item); });
    if (empty) empty.hidden = active.length !== 0;
    if (!toggle) return;
    toggle.disabled = active.length <= 2;
    let expanded = false;
    const update = () => {
      active.forEach((item,index) => { item.hidden = !expanded && index >= 2; });
      toggle.setAttribute('aria-expanded',String(expanded));
      if (label) label.textContent = expanded ? (ja ? '閉じる' : 'Show less') : (ja ? 'お知らせをもっと見る' : 'Show more news');
    };
    toggle.addEventListener('click',() => { expanded = !expanded; update(); });
    update();
  });
</script>
<style>
.home-sections{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(16px,2vw,28px);align-items:stretch}
.home-panel{min-width:0;padding:clamp(18px,2vw,26px);border:1px solid #D9DAD6;border-radius:14px;background:#fff;display:flex;flex-direction:column}
.home-panel:first-child{grid-column:1/-1}
.section-heading{display:flex;align-items:center;gap:10px;margin:0 0 20px;color:#292B2D;font-family:"Baloo 2","Trebuchet MS",sans-serif;font-size:clamp(23px,2.5vw,30px);font-weight:800}
.section-heading :global(svg){width:23px;height:23px;fill:var(--accent);transform:rotate(-18deg);flex:none}
.news-list{display:grid;grid-template-columns:minmax(0,1fr);gap:14px}
.interactive-card{position:relative;display:block;color:#292B2D;text-decoration:none!important;cursor:pointer;transition:transform .22s ease,box-shadow .22s ease,background-color .22s ease;z-index:0}
.interactive-card:hover{transform:scale(1.025);z-index:2;box-shadow:0 0 0 4px var(--accent,#B58A76),0 10px 22px rgba(80,53,39,.14)}
.interactive-card:focus-visible{outline:3px solid var(--accent,#B58A76);outline-offset:5px;z-index:2}
.interactive-card,.interactive-card *{text-decoration:none!important}
.news-entry{min-width:0}.news-entry :global(.home-game-entry){grid-template-columns:clamp(100px,12vw,150px) minmax(0,1fr)}
.news-entry[hidden],.empty-message[hidden],.section-more[hidden]{display:none!important}
.news-top{display:flex;align-items:center;flex-wrap:wrap;gap:9px;margin-bottom:9px}
.news-top time{font-size:11px;color:#777A7B}
.news-badge{padding:4px 10px;border-radius:999px;background:#B58A76;color:white;font-size:10px;font-weight:800;letter-spacing:.04em}
.news-badge.update{background:#497C78}.news-badge.recommended{background:#765E8B}
.news-entry strong{display:block;font-size:15px;margin-bottom:6px}
.news-description{display:block;font-size:12px;line-height:1.6;color:#55585A}
.empty-message{grid-column:1/-1;color:#777A7B;font-size:13px}
.section-more{width:100%;box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:46px;margin-top:18px;padding:10px 15px;background:#fff;border:1px solid #777A7B;border-radius:8px;color:#292B2D;font:inherit;font-size:14px;font-weight:700;text-align:left;cursor:pointer}
.section-more:hover:not(:disabled){background:#F0EFEB}.section-more:disabled{cursor:not-allowed;color:#9B9D9C;border-color:#D9DAD6;background:#F7F7F5;opacity:.7}
.chevron{font-size:25px;line-height:1;font-weight:400}
.works-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;flex:1}
.work-entry{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:175px;padding:12px 6px;border:1px solid #D9DAD6;border-radius:10px;background:#F9F9F7;text-align:center;--accent:var(--work-accent)}
.work-entry:hover{background:#fff}
.work-icon{font-size:27px}.work-entry strong{font-size:15px}.work-count{font-size:12px;color:#777A7B}
.other-grid{display:flex;flex-direction:column;gap:12px}
.other-entry{display:flex;align-items:center;gap:12px;min-height:64px;padding:10px 14px;border:1px solid #D9DAD6;border-radius:9px;background:#F9F9F7;--accent:#A292BA}
.other-entry:hover{background:#fff}.other-entry>span:nth-child(2){display:flex;flex-direction:column;gap:4px;flex:1;min-width:0}
.other-entry strong{font-size:14px}.other-entry small{font-size:11px;color:#777A7B;line-height:1.4}
.other-symbol{width:30px;text-align:center;font-size:23px;font-weight:800}.other-symbol.qiita{color:#55C500}
.other-free-comment{margin:16px 0 0;padding:14px 2px 0;color:#55585A;font-size:13px;line-height:1.8;border-top:1px solid #E2E3DF}
@media(max-width:760px){.home-sections{grid-template-columns:1fr}.home-panel:first-child{grid-column:auto}.news-list{grid-template-columns:1fr}.news-entry :global(.home-game-entry){grid-template-columns:96px minmax(0,1fr)}.works-grid{gap:8px}.work-entry{min-height:110px}.work-entry strong{font-size:13px}.work-count{font-size:10px}}
@media(prefers-reduced-motion:reduce){.interactive-card{transition:none}.interactive-card:hover{transform:none}}
</style>
