---
import '../styles/global.css';
import {copy, type Lang} from '../data/content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props {lang:Lang; title?:string; description?:string}
const {lang,title,description}=Astro.props;
const t=copy[lang];
const path=Astro.url.pathname;
const alternate=lang==='ja'?'/en'+(path==='/'?'/':path):(path.replace(/^\/en(?=\/)/,'')||'/');
const origin='https://tanzyyy-dev.github.io';
const canonical=new URL(path,origin).href;
const otherUrl=new URL(alternate,origin).href;
const home=lang==='ja'?'/':'/en/';
const gaMeasurementId = 'G-JERJNVGDH7';
const enableAnalytics = import.meta.env.PROD;
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@800&display=swap" rel="stylesheet"/>
<title>{title?title+' | tanzyyy-dev':'tanzyyy-dev | Projects'}</title>
<meta name="description" content={description??t.intro}/>
<link rel="canonical" href={canonical}/>
<link rel="alternate" hreflang="ja" href={lang==='ja'?canonical:otherUrl}/>
<link rel="alternate" hreflang="en" href={lang==='en'?canonical:otherUrl}/>
<meta property="og:type" content="website"/><meta property="og:title" content={title??'tanzyyy-dev'}/>
<meta property="og:description" content={description??t.intro}/><meta property="og:url" content={canonical}/>
{enableAnalytics && <>
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaMeasurementId}`}></script>
<script is:inline define:vars={{ gaMeasurementId }}>
  window.dataLayer = window.dataLayer || [];
  window.gtag = function(){ window.dataLayer.push(arguments); };
  window.gtag('js', new Date());
  window.gtag('config', gaMeasurementId);
</script>
</>}
</head>
<body class:list={{"home-palette":path===home,"project-palette":path.includes("/projects/")}}>
<a class="skip" href="#main">{lang==='ja'?'本文へ移動':'Skip to content'}</a>
<SiteHeader lang={lang} path={path} alternate={alternate} home={home} />
<main id="main"><slot/></main>
<SiteFooter />
<script>
  // Delegate clicks so links navigate normally, including external destinations.
  declare global { interface Window { gtag?: (...args: any[]) => void } }
  document.addEventListener('click', event => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const element = target.closest<HTMLElement>('[data-ga-event]');
    if (!element || element.hasAttribute('disabled')) return;
    const name = element.dataset.gaEvent;
    if (!name || typeof window.gtag !== 'function') return;
    const params: Record<string,string> = {};
    if (element.dataset.gaSource) params.source = element.dataset.gaSource;
    if (element.dataset.gaProject) params.project_id = element.dataset.gaProject;
    if (element.dataset.gaCategory) params.project_category = element.dataset.gaCategory;
    if (element.dataset.gaDestination) params.destination = element.dataset.gaDestination;
    // Prefer beacon transport for links, so navigation does not discard the hit.
    const link = element.closest<HTMLAnchorElement>('a[href]');
    if (!link) {
      window.gtag('event', name, params);
      return;
    }
    const isSameTab = !link.target || link.target === '_self';
    const isPlainClick = event instanceof MouseEvent && event.button === 0 &&
      !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
    if (!isSameTab || !isPlainClick || link.hasAttribute('download')) {
      window.gtag('event', name, { ...params, transport_type: 'beacon' });
      return;
    }
    // Keep normal same-tab navigation reliable even if the GA callback never runs.
    event.preventDefault();
    let navigated = false;
    const navigate = () => {
      if (navigated) return;
      navigated = true;
      window.location.assign(link.href);
    };
    window.gtag('event', name, {
      ...params,
      transport_type: 'beacon',
      event_callback: navigate,
      event_timeout: 350
    });
    window.setTimeout(navigate, 400);
  });
</script>
</body></html>
