---
import Base from '../../layouts/Base.astro';
import { copy } from '../../data/content';

const t = copy.en;
---
<Base lang="en" title={t.about} description={t.aboutLead}>
  <div class="wrap page">
    <h1>{t.about}</h1>
    <p class="lead">{t.aboutLead}</p>
    <p>{t.aboutBody}</p>
  </div>
</Base>
