---
import type {Lang} from '../data/content';
interface Props { lang: Lang }
const {lang}=Astro.props;
const ja=lang==='ja';
---
<section class="home-intro" aria-labelledby="home-title">
  <h1 id="home-title">{ja?'tanzyyy-devについて':'About tanzyyy-dev'}</h1>
  <p>{ja?'ゲームやWebサービスなど、制作した作品をまとめているサイトです。作品の紹介や制作内容をご覧いただけます。':'A website collecting games, web services, and other projects I have made. Browse the projects and learn about the work behind them.'}</p>
  <div class="home-links">
    <a href={ja?'/projects/':'/en/projects/'}>{ja?'作品一覧':'Projects'} <span aria-hidden="true">→</span></a>
    <a href={ja?'/about/':'/en/about/'}>{ja?'制作者について':'About the creator'} <span aria-hidden="true">→</span></a>
  </div>
  <section class="home-x" aria-labelledby="home-x-title">
    <div class="home-x-profile">
      <div class="home-x-identity">
        <span class="home-x-avatar" aria-hidden="true">T</span>
        <div>
          <h2 id="home-x-title">Tanzyyy</h2>
          <a class="home-x-handle" href="https://x.com/tanzyto40" target="_blank" rel="noopener noreferrer">@tanzyto40</a>
        </div>
      </div>
      <div class="home-x-actions">
        <a class="home-x-visit" href="https://x.com/tanzyto40" target="_blank" rel="noopener noreferrer">{ja?'Xでプロフィールを見る':'View profile on X'} <span aria-hidden="true">↗</span></a>
        <a class="twitter-follow-button" href="https://x.com/tanzyto40" data-show-count="false" data-size="large">Follow @tanzyto40</a>
      </div>
    </div>
  </section>
  <script is:inline async src="https://platform.x.com/widgets.js" charset="utf-8"></script>
</section>
<style>
.home-intro{width:100%}
.home-intro h1{margin:0 0 16px;font-size:clamp(27px,3vw,36px);font-weight:800;line-height:1.35;letter-spacing:-.045em}
.home-intro p{margin:0;color:#405e67;font-size:16px;line-height:1.9}
.home-links{display:flex;flex-wrap:wrap;gap:12px 30px;margin-top:24px}
.home-links a{display:inline-flex;align-items:center;gap:8px;min-height:44px;color:#1c6074;font-size:15px;font-weight:700;text-decoration:underline;text-underline-offset:5px}
.home-links a:hover{color:#123d4a}
.home-x{margin-top:40px;padding-top:24px;border-top:1px solid #ccdadd}
.home-x-profile{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}
.home-x-identity{display:flex;align-items:center;gap:16px}
.home-x-avatar{display:grid;place-items:center;width:64px;height:64px;flex:none;border-radius:50%;background:#183945;color:#fff;font-size:32px;font-weight:800}
.home-x-identity h2{margin:0;font-size:23px;line-height:1.3;letter-spacing:-.03em}
.home-x-handle{font-size:14px;color:#405e67;text-underline-offset:4px}
.home-x-actions{display:flex;align-items:center;gap:16px;flex-wrap:wrap}
.home-x-visit{font-size:14px;font-weight:700;color:#1c6074;text-underline-offset:4px}
@media(max-width:760px){.home-intro h1{font-size:27px}.home-links{margin-top:20px}}
</style>
